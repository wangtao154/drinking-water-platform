# ==============================================================================
# 直饮水平台 - 环境变量示例
# 使用前复制为 .env，并替换所有生产密钥。
# ==============================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=DrinkingWater@2026
MYSQL_DATABASE=drinking_water

# ---- Redis ----
REDIS_PASSWORD=Redis@2026

# ---- InfluxDB ----
INFLUXDB_PASSWORD=InfluxDB@2026
INFLUXDB_ORG=platform
INFLUXDB_BUCKET=drinking_water
INFLUXDB_TOKEN=please-change-influxdb-token

# ---- RabbitMQ ----
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=RabbitMQ@2026

# ---- EMQX ----
EMQX_DASHBOARD_PASSWORD=EMQX@2026
EMQX_AUTH_HTTP_URL=http://iot-service:8085/internal/auth/device
EMQX_ACL_HTTP_URL=http://iot-service:8085/internal/acl/device

# ---- MinIO ----
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=MinIO@2026
MINIO_BUCKET=drinking-water

# ---- Nacos ----
NACOS_AUTH_TOKEN=please-change-nacos-auth-token
NACOS_PASSWORD=Nacos@2026

# ---- JWT ----
JWT_SECRET=please-change-jwt-secret
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# ---- 服务间内部调用 ----
INTERNAL_SERVICE_TOKEN=please-change-internal-service-token

# ---- 扫码取水 ----
WATER_SCAN_MIN_PAY_AMOUNT=1
WATER_SCAN_UNIT_PRICE_CENTS_PER_LITER=0
WATER_SCAN_MIN_TARGET_ML=100
WATER_SCAN_MAX_TARGET_ML=10000
WATER_SCAN_SIGN_SECRET=please-change-water-scan-sign-secret

# ---- 微信支付 ----
WECHAT_PAY_ENABLED=false
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_PRIVATE_KEY_PATH=/app/certs/apiclient_key.pem
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=/app/certs/pub_key.pem
WECHAT_PAY_NOTIFY_URL=https://zyswx.juconyun.com/api/v1/water/pay/wechat/notify

# ---- 微信小程序 ----
WX_APPID=
WX_APPSECRET=
WX_MOCK=true

# ---- 微信服务号 ----
WX_OFFICIAL_APPID=
WX_OFFICIAL_APPSECRET=
WX_OFFICIAL_OAUTH_CALLBACK_URL=https://zyswx.juconyun.com/api/v1/wechat/official/callback
WX_OFFICIAL_MOCK=true
WX_OFFICIAL_BIND_TOKEN_EXPIRE_SECONDS=600
WX_OFFICIAL_SERVER_TOKEN=please-change-official-server-token
WX_OFFICIAL_WORK_ORDER_ASSIGNED_TEMPLATE_ID=
WX_MINI_PROGRAM_APPID=
WX_OFFICIAL_MINI_PROGRAM_JUMP_ENABLED=false
WX_WORK_ORDER_DETAIL_PAGE=pages/work-order/detail/index?id={orderId}

# ---- AI / Qwen RO膜寿命预测 ----
AI_QWEN_ENABLED=true
AI_QWEN_API_KEY=
AI_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_QWEN_MODEL=qwen3.7-plus
AI_QWEN_TIMEOUT_SECONDS=45
AI_INFLUXDB_TIMEOUT_SECONDS=90
AI_RO_DEFAULT_RATED_PURE_LITERS=12000
AI_RO_DEFAULT_RANGE_DAYS=30
AI_RO_DEFAULT_AGGREGATE_EVERY=30m
