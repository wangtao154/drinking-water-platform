# ==============================================================================
# 直饮水平台 - 环境变量配置
# 使用前复制为 .env 并修改密码： cp .env.example .env
# ==============================================================================

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=DrinkingWater@2026
MYSQL_DATABASE=drinking_water

# ---- Redis ----
REDIS_PASSWORD=Redis@2026

# ---- InfluxDB ----
INFLUXDB_PASSWORD=InfluxDB@2026
INFLUXDB_ORG=platform
INFLUXDB_BUCKET=drinking_water
INFLUXDB_TOKEN=drinking-water-super-token-please-change-in-production

# ---- RabbitMQ ----
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=RabbitMQ@2026

# ---- EMQX ----
EMQX_DASHBOARD_PASSWORD=EMQX@2026
# EMQX 认证回调地址由 iot-service 提供
EMQX_AUTH_HTTP_URL=http://iot-service:8085/internal/auth/device
EMQX_ACL_HTTP_URL=http://iot-service:8085/internal/acl/device

# ---- MinIO ----
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=MinIO@2026
MINIO_BUCKET=drinking-water

# ---- Nacos ----
NACOS_AUTH_TOKEN=ZHJpbmtpbmctd2F0ZXItbmFjb3MtYXV0aC1zZWNyZXQta2V5LTIwMjY=
NACOS_PASSWORD=Nacos@2026

# ---- JWT ----
JWT_SECRET=drinking-water-platform-jwt-secret-key-please-change-in-production-2026
JWT_ACCESS_EXPIRE=7200
JWT_REFRESH_EXPIRE=604800

# ---- 服务间内部调用 ----
INTERNAL_SERVICE_TOKEN=please-change-in-production

